{
  "manifest_version": 3,
  "name": "YouTube macOS PiP",
  "version": "3.1.3",
  "description": "ChromeのYouTubeからmacOSのネイティブPiPを1操作で開始し、最新の再生状態を元のタブへ引き継ぎます。",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "macOS PiPを切り替える（Option+Shift+P）"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "pip.js",
        "content.js"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      }
    }
  },
  "key": ""
}
